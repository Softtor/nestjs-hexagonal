/** Pure domain event with stable identity and timestamp, including on retry. */
export abstract class DomainEvent {
  readonly eventName: string;
  readonly aggregateId: string;
  readonly occurredOn: Date;
  readonly eventId: string;

  protected constructor(eventName: string, aggregateId: string, occurredOn: Date = new Date(), eventId: string = crypto.randomUUID()) {
    this.eventName = eventName;
    this.aggregateId = aggregateId;
    this.occurredOn = new Date(occurredOn.getTime());
    this.eventId = eventId;
  }
}

